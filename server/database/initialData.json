    {
      "id": 1,
      "title_hi": "छठ महापर्व 2026 आमंत्रण",
      "title_en": "Chhath Mahaparv 2026 Invitation",
      "message_hi": "राणाजी छठ पूजा पार्क समिति (रजि.) की ओर से समस्त श्रद्धालु 15-16 नवम्बर 2026 को सायंकाल एवं सुबह के अर्घ्य हेतु सपरिवार सादर आमंत्रित हैं।",
      "message_en": "Ranaji Chhath Puja Park Samiti (Regd.) cordially invites all devotees and their families for the Evening and Morning Arghya on 15-16 November 2026.",
      "is_active": 1,
      "priority": 10,
      "created_at": "2026-11-08 12:03:12"
    },
    {
      "id": 2,
      "title_hi": "वेदी पंजीकरण एवं व्यवस्था सूचना",
      "title_en": "Altar (Vedi) Cleanliness & Arrangements Notice",
      "message_hi": "पार्क में पूजा वेदी के आसपास स्वच्छता बनाए रखें। समिति द्वारा स्वच्छ जल, प्रकाश, प्राथमिक चिकित्सा एवं सुरक्षा के पुख्ता इंतजाम किए गए हैं।",
      "message_en": "Kindly maintain utmost cleanliness around the puja altars in the park. The Samiti has arranged clean water, lighting, first aid, and security for all.",
      "is_active": 1,
      "priority": 5,
      "created_at": "2026-11-08 12:03:12"
    }
  ]
